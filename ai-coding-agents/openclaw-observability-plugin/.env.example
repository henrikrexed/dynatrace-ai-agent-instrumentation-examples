# Dynatrace connection is configured via the OTel Collector, not here.
# Set DT_ENDPOINT and DT_API_TOKEN in /etc/otelcol-contrib/otelcol-env instead.

# Dynatrace requires delta temporality for OTLP metrics.
# The OTel default of `cumulative` will be silently dropped by Dynatrace ingest.
OTEL_EXPORTER_OTLP_METRICS_TEMPORALITY_PREFERENCE=delta
